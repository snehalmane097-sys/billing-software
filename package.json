{
  "name": "gst-billing-workspace",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/build.mjs && node --experimental-sqlite server/index.mjs",
    "server": "node --experimental-sqlite server/index.mjs",
